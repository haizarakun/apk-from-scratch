{
  "package": "com.example.specapp",
  "name": "Spec App",
  "icon_color": "43A047",
  "version_code": 1,
  "version_name": "1.0",
  "widgets": [
    {"type": "text", "id": "title", "text": "こんにちは！ボタンを押してみて"},
    {"type": "image", "src": "logo.png"},
    {"type": "button", "text": "文字を変える",
     "action": {"type": "set_text", "target": "title", "text": "変わりました ✅"}},
    {"type": "button", "text": "サイトを開く",
     "action": {"type": "open_url", "url": "https://github.com/haizarakun/apk-from-scratch"}},
    {"type": "button", "text": "メッセージ",
     "action": {"type": "toast", "text": "やあ！ 👋"}},
    {"type": "text", "id": "news", "text": "（ここに通信結果が出ます）"},
    {"type": "button", "text": "ネットから読み込む",
     "action": {"type": "fetch", "url": "https://api.github.com/zen", "target": "news"}},
    {"type": "list", "items": [
      {"text": "一覧の項目 1"},
      {"text": "一覧の項目 2（タップで開く）",
       "action": {"type": "open_url", "url": "https://example.com"}},
      {"text": "一覧の項目 3"}
    ]}
  ]
}
